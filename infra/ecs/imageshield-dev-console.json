{
  "family": "imageshield-dev-console",
  "networkMode": "host",
  "requiresCompatibilities": [
    "EC2"
  ],
  "executionRoleArn": "arn:aws:iam::225989356895:role/imageshield-dev-exec",
  "taskRoleArn": "arn:aws:iam::225989356895:role/imageshield-dev-no-aws",
  "containerDefinitions": [
    {
      "name": "console",
      "image": "225989356895.dkr.ecr.ap-south-1.amazonaws.com/imageshield/services:486c1b2",
      "essential": true,
      "memory": 160,
      "command": [
        "sh",
        "-c",
        "uvicorn imageshield.console.app:create_app --factory --host 0.0.0.0 --port 8082"
      ],
      "environment": [
        {
          "name": "SERVICES_BASE_URL",
          "value": "http://localhost:8081"
        }
      ],
      "secrets": [
        {
          "name": "SERVICE_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:225989356895:secret:imageshield/dev/service-token/backend-to-services-uqZXJj:token::"
        },
        {
          "name": "ADMIN_SERVICE_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:225989356895:secret:imageshield/dev/service-token/admin-Omv7uR:token::"
        },
        {
          "name": "CONSOLE_OPERATORS",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:225989356895:secret:imageshield/dev/service-token/backend-to-services-uqZXJj:CONSOLE_OPERATORS::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8082/health').status==200 else 1)\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/imageshield/dev",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "console"
        }
      },
      "memoryReservation": 96
    }
  ]
}
