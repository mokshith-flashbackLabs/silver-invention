{
  "family": "imageshield-dev-migrate-services",
  "networkMode": "host",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "arn:aws:iam::225989356895:role/imageshield-dev-exec",
  "taskRoleArn": "arn:aws:iam::225989356895:role/imageshield-dev-services",
  "containerDefinitions": [
    {
      "name": "migrate-services",
      "image": "225989356895.dkr.ecr.ap-south-1.amazonaws.com/imageshield/services:623525b",
      "essential": true,
      "memory": 256,
      "command": ["python", "scripts/migrate.py", "up"],
      "environment": [
        { "name": "ENVIRONMENT", "value": "development" },
        { "name": "LOG_LEVEL", "value": "debug" },
        { "name": "DB_SSLMODE", "value": "require" }
      ],
      "secrets": [
        { "name": "DB_HOST", "valueFrom": "arn:aws:secretsmanager:ap-south-1:225989356895:secret:imageshield/dev/db/migrator_services-dyQTpx:host::" },
        { "name": "DB_PORT", "valueFrom": "arn:aws:secretsmanager:ap-south-1:225989356895:secret:imageshield/dev/db/migrator_services-dyQTpx:port::" },
        { "name": "DB_NAME", "valueFrom": "arn:aws:secretsmanager:ap-south-1:225989356895:secret:imageshield/dev/db/migrator_services-dyQTpx:dbname::" },
        { "name": "DB_USER", "valueFrom": "arn:aws:secretsmanager:ap-south-1:225989356895:secret:imageshield/dev/db/migrator_services-dyQTpx:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-south-1:225989356895:secret:imageshield/dev/db/migrator_services-dyQTpx:password::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/imageshield/dev",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "migrate-services"
        }
      }
    }
  ]
}
