{
  "family": "imageshield-prod-services-worker",
  "x-notes": "PRODUCTION. Two containers, one task, because the relay and the search worker are both small, both stateless and both die with the instance; splitting them would double the placement bookkeeping for no isolation. Generated from infra/ecs/imageshield-dev-services-worker.json by applying only the environment-specific values. Dev already carried ENVIRONMENT=production and SEARCH_PROVIDER=hive here, which reads like an inconsistency and is not one: config.py refuses development+hive, and these two containers must hold a live adapter to do anything at all, so dev's search worker really does run in the production configuration and really does spend Hive money. Production changes the region, the queues, the collections, the log group and the roles; it changes nothing about that pair. LOG_LEVEL was already info. See services.json notes on the two ATTRIBUTION_ values, which are unset here as in dev.",
  "networkMode": "host",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "arn:aws:iam::225989356895:role/imageshield-prod-exec",
  "taskRoleArn": "arn:aws:iam::225989356895:role/imageshield-prod-services",
  "containerDefinitions": [
    {
      "name": "relay",
      "image": "225989356895.dkr.ecr.us-east-1.amazonaws.com/imageshield/services:${IMAGE_TAG}",
      "essential": true,
      "memory": 160,
      "command": ["python", "-m", "imageshield.relay"],
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "REKOGNITION_REGION", "value": "us-east-1" },
        { "name": "IDENTITY_COLLECTION", "value": "identity-prod-v1" },
        { "name": "DISCOVERED_COLLECTION", "value": "discovered-prod-v1" },
        { "name": "ENROLMENT_QUALITY_FILTER", "value": "HIGH" },
        { "name": "SEARCH_PROVIDER", "value": "hive" },
        { "name": "ATTRIBUTION_MAX_INFLIGHT", "value": "4" },
        { "name": "SEARCH_MATCH_THRESHOLD", "value": "95" },
        { "name": "FACE_MATCH_THRESHOLD", "value": "95" },
        { "name": "ENROLMENT_COLLISION_THRESHOLD", "value": "97" },
        { "name": "MIN_ENROLMENT_AGE", "value": "0" },
        { "name": "MIN_DISCOVERY_AGE", "value": "18" },
        { "name": "LIVENESS_MIN_CONFIDENCE", "value": "90" },
        { "name": "LIVENESS_SESSION_TTL_SECONDS", "value": "600" },
        { "name": "LIVENESS_MAX_ATTEMPTS_24H", "value": "10" },
        { "name": "DB_POOL_MAX_SIZE", "value": "3" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "HIVE_BASE_URL", "value": "https://api.thehive.ai" },
        { "name": "SQS_IDENTITY_INDEX_URL", "value": "https://sqs.us-east-1.amazonaws.com/225989356895/imageshield-prod-identity-index" },
        { "name": "SQS_SEARCH_RUNS_URL", "value": "https://sqs.us-east-1.amazonaws.com/225989356895/imageshield-prod-search-runs" },
        { "name": "SQS_CONFIRM_HITS_URL", "value": "https://sqs.us-east-1.amazonaws.com/225989356895/imageshield-prod-confirm-hits" },
        { "name": "FETCHER_BASE_URL", "value": "http://localhost:8083" },
        { "name": "CSAM_AGE_LOW_THRESHOLD", "value": "18" }
      ],
      "secrets": [
        { "name": "DB_HOST", "valueFrom": "${SECRET_DB_APP_SERVICES}:host::" },
        { "name": "DB_PORT", "valueFrom": "${SECRET_DB_APP_SERVICES}:port::" },
        { "name": "DB_NAME", "valueFrom": "${SECRET_DB_APP_SERVICES}:dbname::" },
        { "name": "DB_USER", "valueFrom": "${SECRET_DB_APP_SERVICES}:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "${SECRET_DB_APP_SERVICES}:password::" },
        { "name": "SERVICE_TOKEN", "valueFrom": "${SECRET_SERVICE_TOKEN_BACKEND}:token::" },
        { "name": "ADMIN_SERVICE_TOKEN", "valueFrom": "${SECRET_SERVICE_TOKEN_ADMIN}:token::" },
        { "name": "HIVE_API_KEY", "valueFrom": "${SECRET_HIVE}:api_key::" },
        { "name": "GOOGLE_VISION_API_KEY", "valueFrom": "${SECRET_GOOGLE_VISION}:api_key::" },
        { "name": "FETCHER_TOKEN", "valueFrom": "${SECRET_SERVICE_TOKEN_BACKEND}:FETCHER_TOKEN::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/imageshield/prod",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "relay"
        }
      }
    },
    {
      "name": "search-worker",
      "image": "225989356895.dkr.ecr.us-east-1.amazonaws.com/imageshield/services:${IMAGE_TAG}",
      "essential": true,
      "memory": 288,
      "command": ["python", "-m", "imageshield.search.worker"],
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "REKOGNITION_REGION", "value": "us-east-1" },
        { "name": "IDENTITY_COLLECTION", "value": "identity-prod-v1" },
        { "name": "DISCOVERED_COLLECTION", "value": "discovered-prod-v1" },
        { "name": "ENROLMENT_QUALITY_FILTER", "value": "HIGH" },
        { "name": "SEARCH_PROVIDER", "value": "hive" },
        { "name": "ATTRIBUTION_MAX_INFLIGHT", "value": "4" },
        { "name": "SEARCH_MATCH_THRESHOLD", "value": "95" },
        { "name": "FACE_MATCH_THRESHOLD", "value": "95" },
        { "name": "ENROLMENT_COLLISION_THRESHOLD", "value": "97" },
        { "name": "MIN_ENROLMENT_AGE", "value": "0" },
        { "name": "MIN_DISCOVERY_AGE", "value": "18" },
        { "name": "LIVENESS_MIN_CONFIDENCE", "value": "90" },
        { "name": "LIVENESS_SESSION_TTL_SECONDS", "value": "600" },
        { "name": "LIVENESS_MAX_ATTEMPTS_24H", "value": "10" },
        { "name": "DB_POOL_MAX_SIZE", "value": "3" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "HIVE_BASE_URL", "value": "https://api.thehive.ai" },
        { "name": "SQS_IDENTITY_INDEX_URL", "value": "https://sqs.us-east-1.amazonaws.com/225989356895/imageshield-prod-identity-index" },
        { "name": "SQS_SEARCH_RUNS_URL", "value": "https://sqs.us-east-1.amazonaws.com/225989356895/imageshield-prod-search-runs" },
        { "name": "SQS_CONFIRM_HITS_URL", "value": "https://sqs.us-east-1.amazonaws.com/225989356895/imageshield-prod-confirm-hits" },
        { "name": "FETCHER_BASE_URL", "value": "http://localhost:8083" },
        { "name": "CSAM_AGE_LOW_THRESHOLD", "value": "18" }
      ],
      "secrets": [
        { "name": "DB_HOST", "valueFrom": "${SECRET_DB_APP_SERVICES}:host::" },
        { "name": "DB_PORT", "valueFrom": "${SECRET_DB_APP_SERVICES}:port::" },
        { "name": "DB_NAME", "valueFrom": "${SECRET_DB_APP_SERVICES}:dbname::" },
        { "name": "DB_USER", "valueFrom": "${SECRET_DB_APP_SERVICES}:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "${SECRET_DB_APP_SERVICES}:password::" },
        { "name": "SERVICE_TOKEN", "valueFrom": "${SECRET_SERVICE_TOKEN_BACKEND}:token::" },
        { "name": "ADMIN_SERVICE_TOKEN", "valueFrom": "${SECRET_SERVICE_TOKEN_ADMIN}:token::" },
        { "name": "HIVE_API_KEY", "valueFrom": "${SECRET_HIVE}:api_key::" },
        { "name": "GOOGLE_VISION_API_KEY", "valueFrom": "${SECRET_GOOGLE_VISION}:api_key::" },
        { "name": "FETCHER_TOKEN", "valueFrom": "${SECRET_SERVICE_TOKEN_BACKEND}:FETCHER_TOKEN::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/imageshield/prod",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "search-worker"
        }
      }
    }
  ]
}
