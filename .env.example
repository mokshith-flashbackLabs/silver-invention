# ImageShield services — environment reference.
# Copy to .env.local for local development (loaded automatically; existing
# environment variables always win). Every key here is validated at boot;
# a missing or malformed key exits the process non-zero.
#
# NEVER commit real secrets. Deployed secrets come from AWS Secrets Manager
# (Phase 5); placeholder values like "changeme" are rejected at boot.

# development | test | production (default). The SERVICE_TOKEN_AUTH_DISABLED
# bypass only takes effect when this is 'development'.
ENVIRONMENT=development

HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Local stack (docker compose -f docker-compose.local.yml up).
# Host ports 15433 / 14566 deliberately differ from Flashback's local stack.
DATABASE_URL=postgresql://imageshield:imageshield@localhost:15433/imageshield

# Deployed alternative to DATABASE_URL — NOT for local dev, uncomment only to
# test the parts path. Some environments cannot publish a single DATABASE_URL:
# an ECS `secrets` entry injects exactly one JSON key per environment
# variable, and an RDS-shaped Secrets Manager secret has no `url` key. When
# DATABASE_URL is unset, Config composes it from all five of these (a partial
# set refuses to boot, naming whichever is missing); DATABASE_URL always wins
# if both forms are set. DB_SSLMODE defaults to `require` in config — the RDS
# parameter group sets rds.force_ssl = 1, so a connection without it is
# refused — and should not be overridden to anything weaker.
# DB_HOST=db.internal
# DB_PORT=5432
# DB_NAME=imageshield
# DB_USER=app_services
# DB_PASSWORD=local-dev-db-password
# DB_SSLMODE=require

# Proxy <-> services shared tokens. Min 16 chars, MUST differ from each other.
SERVICE_TOKEN=local-dev-service-token-000001
ADMIN_SERVICE_TOKEN=local-dev-admin-token-0000002

AWS_REGION=us-east-1
# Must EQUAL AWS_REGION — boot refuses otherwise. A Rekognition collection is
# regional, so the wrong region searches an empty collection and reports "no
# matches" with nothing logged (D7).
REKOGNITION_REGION=us-east-1
IDENTITY_COLLECTION=identity-v1
# Validated, not read in v1 — clustering is out of scope (CLAUDE.md §6).
DISCOVERED_COLLECTION=discovered-v1
# Validated, NOT READ, and giving it a reader is invariant #1 territory:
# identity must never come from a similarity score.
ENROLMENT_COLLISION_THRESHOLD=99
# Provider face-search threshold. Distinct from FACE_MATCH_THRESHOLD
# (enrolment) and ATTRIBUTION_MATCH_THRESHOLD — one threshold per purpose
# (#1b). Exactly 80 is refused: that is Rekognition's default, i.e. unchosen.
SEARCH_MATCH_THRESHOLD=88.5
ATTRIBUTION_MAX_INFLIGHT=4
# 'stub' dispatches no provider call. REQUIRED when ENVIRONMENT=development:
# the dev keys are real, Hive has no sandbox, and its price is NULL so the
# budget guard caps nothing.
SEARCH_PROVIDER=stub
DEV_FACE_CEILING=50
# 'debug' is refused when ENVIRONMENT=production.
LOG_LEVEL=debug

# Thresholds — config only, no inline literals anywhere (CLAUDE.md §4 1b).
LIVENESS_MIN_CONFIDENCE=90
FACE_MATCH_THRESHOLD=95
LIVENESS_SESSION_TTL_SECONDS=600
LIVENESS_MAX_ATTEMPTS_24H=5

# Two ages, not one (step 8). MIN_ENROLMENT_AGE is who may enrol — consent,
# guardianship and household seats work for minors. MIN_DISCOVERY_AGE is who
# may be SEARCHED, and it is 18 because a successful discovery result for a
# minor is CSAM in this pipeline and the screening/reporting path does not
# exist yet. The proxy computes `subject_is_adult` by comparing DOB against
# MIN_DISCOVERY_AGE; lowering it here does not by itself enable minor
# discovery (see src/imageshield/subjects/eligibility.py).
MIN_ENROLMENT_AGE=13
MIN_DISCOVERY_AGE=18

# Measured ≈$0.015 per completed Face Liveness check (devtools/harness,
# 2026-08-05). Input to the step-8 per-provider budget logic. Optional —
# defaults to 0.015 in config.
# LIVENESS_COST_PER_CHECK_USD=0.015

# Hive Media Search (Phase 4). Real key comes from Secrets Manager.
HIVE_API_KEY=local-dev-hive-key
HIVE_BASE_URL=https://api.thehive.ai

# Google Cloud Vision WEB_DETECTION — used by devtools/harness only for now.
GOOGLE_VISION_API_KEY=local-dev-google-key

# ── Step 8: cost, breakers, kill switches, cadence ──────────────────────────
# All defaulted in config; uncomment only to override.
#
# Circuit breaker. A failure is a timeout, 5xx, connection error or malformed
# response — NOT a 429, and NOT a 200 with zero matches.
# PROVIDER_FAILURE_THRESHOLD=5
# BREAKER_COOLDOWN_SECONDS=300
# BREAKER_COOLDOWN_MAX_SECONDS=3600
#
# Rate limiting: bounded retries with jitter, honouring retry-after.
# PROVIDER_MAX_RETRIES=3
# PROVIDER_RETRY_JITTER_FRACTION=0.25
# PROVIDER_RETRY_MAX_WAIT_SECONDS=30
#
# Kill-switch freshness. Capped at 30s in config — a longer TTL refuses to boot.
# PROVIDER_CONFIG_CACHE_SECONDS=30
#
# Adaptive cadence (the 4-10x cost lever).
# SCAN_INTERVAL_STANDARD_DAYS=7
# SCAN_INTERVAL_RELAXED_DAYS=14
# SCAN_INTERVAL_DORMANT_DAYS=30
# SCAN_NEW_TIER_WEEKS=4
# SCAN_RELAXED_AFTER_EMPTY=8
# SCAN_DORMANT_AFTER_EMPTY=20
# SCAN_PRIORITY_RELEASE_AFTER_EMPTY=13
#
# Alarm thresholds.
# PROVIDER_SPEND_ALARM_FRACTION=0.80
# PROVIDER_SUCCESS_RATE_ALARM=0.90
# PROVIDER_ALARM_WINDOW_HOURS=1

# Attribution (POST /v1/attribute). "Is this face that person" — a different
# quantity from LIVENESS_MIN_CONFIDENCE ("is this a live human") and from a
# face detection confidence ("is this region a face"). One threshold per
# purpose (INVARIANTS #1b).
# ATTRIBUTION_MATCH_THRESHOLD=92.0
# MaxFaces on the search. Boot REFUSES anything below 2: with one candidate, a
# stranger who outranks the household member is the only result returned, the
# candidate filter discards it, and the photo never becomes a seed for its own
# owner — silently, and worse as the collection grows.
# ATTRIBUTION_MAX_CANDIDATES=5

# The URL recheck loop (python -m imageshield.recheck.worker). Its own process:
# it makes outbound requests to hostile third-party hosts, which belongs on its
# own egress path with no VPC access to anything internal (INVARIANTS #11).
# RECHECK_INTERVAL_DAYS=7
# RECHECK_BATCH_SIZE=500
# RECHECK_POLL_INTERVAL_SECONDS=300
# RECHECK_TIMEOUT_SECONDS=5
# RECHECK_MAX_REDIRECTS=2
# Minimum gap between two probes of the SAME domain. Nothing is imposed across
# different domains. Probing one site's 400 URLs in a burst gets you blocked and
# looks like an attack — it is the traffic shape a scanner makes.
# RECHECK_PER_DOMAIN_INTERVAL_SECONDS=2.0

# SQS queues (identity:index / search:runs / confirm:hits). LocalStack URLs
# for local dev.
SQS_IDENTITY_INDEX_URL=http://localhost:14566/000000000000/imageshield-identity-index
SQS_SEARCH_RUNS_URL=http://localhost:14566/000000000000/imageshield-search-runs

# ── Protection score / confirm pipeline (design 2026-08-19) ─────────────────
# Third queue, the fetcher deployable, and the CSAM tripwire's low-end age
# band. All four required — no defaults.
SQS_CONFIRM_HITS_URL=http://localhost:14566/000000000000/imageshield-confirm-hits
FETCHER_BASE_URL=http://localhost:8083
FETCHER_TOKEN=local-dev-fetcher-token-00003
# The age below which moderation labels suggesting a minor trip the CSAM
# quarantine path (design §7 step 7). Required, no default: the age-literal
# gate in tests/test_boundaries.py bans an inline age comparison in config.py,
# and INVARIANTS #8 wants every age floor read from config.
CSAM_AGE_LOW_THRESHOLD=18
#
# Everything below is defaulted in config; uncomment only to override.
#
# The score's structure (which components, what they're made of) is fixed in
# code; only the numbers are config. SCORE_CONFIG_VERSION is stamped onto
# every score_events row so a historical score stays interpretable after a
# retune.
# SCORE_CONFIG_VERSION=score-v1
# SCORE_WEIGHT_POSTURE=40
# SCORE_WEIGHT_COVERAGE=25
# SCORE_WEIGHT_EXPOSURE=25
# SCORE_WEIGHT_THREAT=10
# SCORE_POSTURE_ENROLMENT=10
# SCORE_POSTURE_SEEDS=20
# SCORE_POSTURE_FEEDBACK=5
# SCORE_POSTURE_RECOMMENDATIONS=5
# SCORE_COVERAGE_SCAN=15
# SCORE_COVERAGE_PROVIDERS=10
# SCORE_EXPOSURE_WEIGHT_NCII=12
# SCORE_EXPOSURE_WEIGHT_EXPLICIT=6
# SCORE_EXPOSURE_WEIGHT_BENIGN=2
# SCORE_EXPOSURE_WEIGHT_DEFAULT=6
# SCORE_THREAT_GLOBAL_MAX_PENALTY=2
# SCORE_SEED_TARGET=5
# SCORE_SEED_FRESH_DAYS=90
# SCORE_REC_SOFT_AGE_DAYS=14
# SCORE_SCAN_GRACE_DAYS=3
# SCORE_TICK_INTERVAL_SECONDS=3600
#
# Confirm pipeline: the attribution threshold used inside it, and pHash
# duplicate detection. (The per-provider "most similar" trigger criteria
# CONFIRM_HIVE_MIN_SCORE / CONFIRM_GOOGLE_KINDS were REMOVED on 2026-08-21:
# every new hit now triages, so the subject's decide surface never starves.)
# CONFIRM_FACE_MATCH_THRESHOLD=92.0
# CONFIRM_MAX_FACES=3
# CONFIRM_PHASH_HAMMING_MAX=8
#
# Subject preview: per-user_ref crop renders per rolling 24h (INVARIANTS #32).
# PREVIEW_DAILY_RENDER_CEILING=200

# Uncomment to skip token auth locally. Refuses to take effect unless
# ENVIRONMENT=development.
# SERVICE_TOKEN_AUTH_DISABLED=1
