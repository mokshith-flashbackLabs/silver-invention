    {
      "name": "04 - Scores",
      "description": "The services-side protection score journal for one subject — a control-room quantity. The USER-facing Likeness Health Score is computed in the proxy repo, not here.",
      "item": [
        {
          "name": "GET scores/{user_ref} — score + journal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}",
                "type": "text"
              },
              {
                "key": "X-Admin-Service-Token",
                "value": "{{admin_service_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{services_base_url}}/v1/admin/scores/{{user_ref}}",
              "host": [
                "{{services_base_url}}"
              ],
              "path": [
                "v1",
                "admin",
                "scores",
                "{{user_ref}}"
              ]
            },
            "description": "`{score: {score, components, config_version, computed_at}, events: [{delta, component, cause_kind, cause_ref, score_after, created_at}]}`. 404 when the subject has no score. `cause_ref` is an opaque provenance id, never a URL."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Articles",
      "description": "Operator-authored content for the app's in-app feed (spec 2026-08-27). Every user sees every published article; nothing here is per-person. Pictures are pasted `https://` URLs — never bytes — and the console renders them as links, never <img>. The proxy reads published rows through `svc.v_articles` and serves them at `GET /v1/articles`.",
      "item": [
        {
          "name": "GET articles — every status, newest edited first",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}",
                "type": "text"
              },
              {
                "key": "X-Admin-Service-Token",
                "value": "{{admin_service_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{services_base_url}}/v1/admin/articles?limit=50",
              "host": [
                "{{services_base_url}}"
              ],
              "path": [
                "v1",
                "admin",
                "articles"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "`{articles[]}`; `limit` 1–200. Each: `article_id, title, summary, body, images[{url,alt}], sources[{name,url}], status (draft|published|archived), published_at, created_by, updated_by, created_at, updated_at`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST articles — create a draft (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}",
                "type": "text"
              },
              {
                "key": "X-Admin-Service-Token",
                "value": "{{admin_service_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{services_base_url}}/v1/admin/articles",
              "host": [
                "{{services_base_url}}"
              ],
              "path": [
                "v1",
                "admin",
                "articles"
              ]
            },
            "description": "Limits: `title` 1–200, `summary` ≤500, `body` ≤20000 (markdown), `images` ≤10, `sources` ≤10, `alt` ≤300, source `name` 1–120; EVERY url must be `https://` with a host (`http://` → 422). Response `{article_id, status: 'draft'}` — captured into `article_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Older photos of you circulate too\",\n  \"summary\": \"Why a photo from five years ago still matters.\",\n  \"body\": \"Image search can only find copies of what we hold, so a wider set of your own photos widens what we can find.\",\n  \"images\": [\n    {\n      \"url\": \"https://cdn.example/hero.jpg\",\n      \"alt\": \"A photo album\"\n    }\n  ],\n  \"sources\": [\n    {\n      \"name\": \"Example News\",\n      \"url\": \"https://news.example/story\"\n    }\n  ],\n  \"operator\": \"{{operator}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json(); if (b && b.article_id) pm.collectionVariables.set('article_id', b.article_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET articles/{article_id}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}",
                "type": "text"
              },
              {
                "key": "X-Admin-Service-Token",
                "value": "{{admin_service_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{services_base_url}}/v1/admin/articles/{{article_id}}",
