          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}",
                "type": "text"
              },
              {
                "key": "X-Admin-Service-Token",
                "value": "{{admin_service_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{services_base_url}}/v1/admin/threat-events/{{event_id}}/retract",
              "host": [
