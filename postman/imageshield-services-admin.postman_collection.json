    {
      "name": "02 - Review",
      "description": "The human review lane. Since 2026-08-21 the SUBJECT decides their own hits and the console is metadata-only — staff never see imagery; operators remain the quarantine lane and the override path.",
      "item": [
        {
          "name": "GET review/next — highest-priority pending task, or 204",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}",
                "type": "text"
              },
              {
                "key": "X-Admin-Service-Token",
                "value": "{{admin_service_token}}",
                "type": "text"
