    {
      "name": "03 - Threat events",
      "description": "Admin-curated events that penalise the `threat` component of matched subjects' protection scores. Bounded, decaying, and exactly reversed on retraction (INVARIANTS #46). `penalty` is a decimal STRING.",
      "item": [
        {
          "name": "GET threat-events — newest first",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}",
                "type": "text"
              },
              {
                "key": "X-Admin-Service-Token",
                "value": "{{admin_service_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{services_base_url}}/v1/admin/threat-events",
              "host": [
                "{{services_base_url}}"
              ],
              "path": [
                "v1",
                "admin",
                "threat-events"
              ]
            },
            "description": "`{events[]}`: `event_id, kind, title, body, severity, domains, is_global, penalty, starts_at, expires_at, decay_days, status, created_by, created_at, updated_at`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST threat-events — create (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{service_token}}",
                "type": "text"
              },
              {
                "key": "X-Admin-Service-Token",
                "value": "{{admin_service_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{services_base_url}}/v1/admin/threat-events",
              "host": [
                "{{services_base_url}}"
              ],
              "path": [
                "v1",
                "admin",
                "threat-events"
              ]
            },
            "description": "`kind` ∈ leak | deepfake_wave | platform_incident | other; `severity` 1–5; `domains` non-empty unless `is_global`; `penalty` > 0 as a string; `expires_at` ISO-8601; `decay_days` > 0. Matches every subject with a live infringement on those domains (or everyone when global) and recomputes their scores. Response `{event_id, matched_count}` — captured into `event_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"leak\",\n  \"title\": \"Example: a site went dark\",\n  \"body\": \"Illustrative event created from Postman.\",\n  \"severity\": 3,\n  \"domains\": [\n    \"leak.example\"\n  ],\n  \"is_global\": false,\n  \"penalty\": \"5.00\",\n  \"expires_at\": \"2026-12-31T00:00:00Z\",\n  \"decay_days\": 30,\n  \"operator\": \"{{operator}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json(); if (b && b.event_id) pm.collectionVariables.set('event_id', b.event_id);"
                ]
              }
            }
          ]
        },
